# Пути считаются от корня репозитория. Режим не означает доступности моделей.
APP_MODEL_MODE=replay
APP_DB_PATH=var/insight.db
APP_RECORDINGS_ROOT=data/recordings/text
APP_REPLAY_MODEL_ID=
APP_REPLAY_NORMALIZATION_HASH=
# Только существующий утверждённый ProcessingProfile JSON, без секретов.
# APP_PROCESSING_PROFILE_PATH=var/profiles/current.json
# Для явного partial/media replay профиля; live этим не включается.
# APP_MEDIA_RECORDINGS_PATH=var/recordings/media/known.json
APP_MEDIA_CACHE_ROOT=var/media-success-cache
APP_DATA_ROOT=data
APP_UPLOAD_ROOT=var/uploads
APP_TMP_ROOT=var/tmp

# Внутренние протоколы пока не проверены. Секреты и адреса не выдумываем.
TEXT_MODEL_BASE_URL=
TEXT_MODEL_ID=
TEXT_MODEL_TOKEN=
ASR_BASE_URL=
ASR_MODEL_ID=
ASR_TOKEN=
VL_BASE_URL=
VL_MODEL_ID=
VL_TOKEN=

APP_ISSUE_HOSTS=
APP_P_MAX=50
APP_RETRIEVAL_K=20
APP_PASSPORT_BATCH_MAX_CHARS=16000
APP_MAX_ASSIGN_BATCHES=8
APP_MAX_IMAGE_PIXELS=25000000
APP_MAX_AUDIO_SECONDS=60
APP_DUPLICATE_SUGGESTIONS=false
# Календарная неделя Europe/Moscow, сохранение в архив без рассылки.
APP_WEEKLY_ARCHIVE_ENABLED=true
